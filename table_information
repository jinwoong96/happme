-- ========================================
-- 사용자 인증 테이블
-- 로그인에 필요한 계정 정보만 보관
-- ========================================
CREATE TABLE user (
    user_id           BIGINT      PRIMARY KEY AUTO_INCREMENT, -- 사용자 고유 ID
    name              VARCHAR(100),                           -- 이름
    email             VARCHAR(100) UNIQUE,                    -- 이메일 (로그인 ID)
    password          VARCHAR(255),                           -- 비밀번호 (해시 저장)
    role              VARCHAR(20)  DEFAULT 'USER',            -- 권한 (USER / ADMIN)
    profile_completed BOOLEAN      DEFAULT FALSE,             -- 온보딩(프로필 입력) 완료 여부
    created_at        DATETIME     DEFAULT CURRENT_TIMESTAMP, -- 가입일
    updated_at        DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP -- 수정일
);


-- ========================================
-- 사용자 프로필 테이블
-- 정책 추천 매칭에 사용되는 개인 정보 (가입 후 온보딩 단계에서 입력)
-- user와 1:1 관계
-- ========================================
CREATE TABLE user_profile (
    user_id                 BIGINT  PRIMARY KEY,              -- user 테이블 참조 (1:1)

    -- 기본 정보
    age                     INT,                              -- 나이
    gender                  VARCHAR(10),                      -- 성별
    region                  VARCHAR(50),                      -- 거주 지역 (시/도)
    district                VARCHAR(50),                      -- 거주 지역 (시/군/구)

    -- 학력 정보
    education               VARCHAR(50),                      -- 학력 (고졸/대졸 등)
    school_name             VARCHAR(100),                     -- 학교명
    major                   VARCHAR(100),                     -- 전공
    student_status          VARCHAR(50),                      -- 재학 상태 (재학/휴학/졸업 등)
    graduation_year         INT,                              -- 졸업 연도

    -- 취업/직업 정보
    employment_status       VARCHAR(50),                      -- 취업 상태 (재직/미취업 등)
    occupation              VARCHAR(50),                      -- 직종
    job_seeking             BOOLEAN  DEFAULT FALSE,           -- 구직 활동 여부
    career_history          TEXT,                             -- 경력 사항

    -- 소득/자산 정보 (뺄수도 있음)
    monthly_income          BIGINT,                           -- 월 소득 (원)
    household_income_ratio  INT,                              -- 가구 소득 분위
    household_size          INT,                              -- 가구원 수
    assets                  BIGINT,                           -- 자산 (원)

    -- 가족/특수 상황
    marital_status          VARCHAR(20),                      -- 혼인 상태 (미혼/기혼 등)
    disability              BOOLEAN  DEFAULT FALSE,           -- 장애 여부
    veteran                 BOOLEAN  DEFAULT FALSE,           -- 보훈 대상 여부
    military_status         VARCHAR(20),                      -- 병역 상태 (미필/현역/제대 등)

    -- 창업/사업 정보
    startup_interest        BOOLEAN  DEFAULT FALSE,           -- 창업 관심 여부
    business_owner          BOOLEAN  DEFAULT FALSE,           -- 사업자 여부
    startup_status          VARCHAR(50),                      -- 창업 단계

    -- 기타
    situation               TEXT,                             -- 현재 상황 메모
    housing_status          VARCHAR(50),                      -- 주거 형태
    reason                  TEXT,                             -- 지원 신청 이유 메모

    updated_at              DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, -- 수정일

    FOREIGN KEY (user_id) REFERENCES user(user_id)
);


-- ========================================
-- 정책(공고문) 테이블
-- 온통청년 API에서 받아오는 정책 원문 데이터
-- 컬럼명은 API 원본명 그대로 사용
-- ========================================
CREATE TABLE policy (
    policy_id           BIGINT       PRIMARY KEY AUTO_INCREMENT, -- 정책 고유 ID (내부용)
    plcyNo              VARCHAR(50)  UNIQUE,                     -- 정책 번호 (API 원본: plcyNo)
    plcyNm              VARCHAR(255) NOT NULL,                   -- 정책명 (API 원본: plcyNm)
    plcyKywdNm          VARCHAR(255) NOT NULL,                   -- 정책 키워드 (API 원본: plcyKywdNm)
    plcyExplnCn         TEXT         NOT NULL,                   -- 정책 설명 (API 원본: plcyExplnCn)
    lclsfNm             VARCHAR(100) NOT NULL,                   -- 대분류명 (API 원본: lclsfNm)
    mclsfNm             VARCHAR(100) NOT NULL,                   -- 중분류명 (API 원본: mclsfNm)
    plcySprtCn          TEXT         NOT NULL,                   -- 지원 내용 (API 원본: plcySprtCn)

    -- 기관 정보
    sprvsnInstCdNm      VARCHAR(100),                            -- 주관 기관명 (API 원본: sprvsnInstCdNm)
    sprvsnInstPicNm     VARCHAR(50),                             -- 주관 기관 담당자 (API 원본: sprvsnInstPicNm)
    operInstCdNm        VARCHAR(100),                            -- 운영 기관명 (API 원본: operInstCdNm)
    operInstPicNm       VARCHAR(50),                             -- 운영 기관 담당자 (API 원본: operInstPicNm)

    -- 사업 기간
    bizPrdBgngYmd       VARCHAR(20),                             -- 사업 시작일 (API 원본: bizPrdBgngYmd)
    bizPrdEndYmd        VARCHAR(20),                             -- 사업 종료일 (API 원본: bizPrdEndYmd)
    bizPrdEtcCn         VARCHAR(255),                            -- 사업 기간 기타 (API 원본: bizPrdEtcCn)

    -- 신청 정보
    plcyAplyMthdCn      TEXT,                                    -- 신청 방법 (API 원본: plcyAplyMthdCn)
    aplyUrlAddr         VARCHAR(500),                            -- 신청 URL (API 원본: aplyUrlAddr)
    sbmsnDcmntCn        TEXT         NOT NULL,                   -- 제출 서류 (API 원본: sbmsnDcmntCn)
    aplyYmd             VARCHAR(100) NOT NULL,                   -- 신청 기간 텍스트 (API 원본: aplyYmd)
    refUrlAddr1         VARCHAR(500),                            -- 참고 URL 1 (API 원본: refUrlAddr1)
    refUrlAddr2         VARCHAR(500),                            -- 참고 URL 2 (API 원본: refUrlAddr2)
    etcMttrCn           TEXT,                                    -- 기타 사항 (API 원본: etcMttrCn)

    -- 지원 대상 조건
    sprtSclCnt          INT,                                     -- 지원 규모 인원 (API 원본: sprtSclCnt)
    sprtTrgtMinAge      INT          NOT NULL,                   -- 지원 대상 최소 나이 (API 원본: sprtTrgtMinAge)
    sprtTrgtMaxAge      INT          NOT NULL,                   -- 지원 대상 최대 나이 (0이면 제한 없음, API 원본: sprtTrgtMaxAge)

    -- 소득 조건
    earnMinAmt          BIGINT,                                  -- 최소 소득 금액 (API 원본: earnMinAmt)
    earnMaxAmt          BIGINT,                                  -- 최대 소득 금액 (API 원본: earnMaxAmt)
    earnEtcCn           TEXT         NOT NULL,                   -- 소득 기타 조건 (API 원본: earnEtcCn)
    earnCndSeCd         VARCHAR(20),                             -- 소득 조건 구분 코드 (API 원본: earnCndSeCd)

    -- 자격 조건
    addAplyQlfcCndCn    TEXT         NOT NULL,                   -- 추가 신청 자격 조건 (API 원본: addAplyQlfcCndCn)
    ptcpPrpTrgtCn       TEXT         NOT NULL,                   -- 참여 제한 대상 (API 원본: ptcpPrpTrgtCn)
    mrgSttsCd           VARCHAR(20),                             -- 혼인 상태 조건 코드 (API 원본: mrgSttsCd)

    -- 메타
    inqCnt              INT          DEFAULT 0,                  -- 조회수 (API 원본: inqCnt)
    frstRegDt           DATETIME,                                -- 최초 등록일 (API 원본: frstRegDt)
    lastMdfcnDt         DATETIME,                                -- 최종 수정일 (API 원본: lastMdfcnDt)
    createdAt           DATETIME     DEFAULT CURRENT_TIMESTAMP,  -- DB 저장일
    updatedAt           DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP -- DB 수정일
);

-- 나이 범위 검색 인덱스
CREATE INDEX idx_policy_age ON policy (sprtTrgtMinAge, sprtTrgtMaxAge);


-- ========================================
-- 정책 대상 지역 테이블
-- 정책 1개 : 지역 N개 (1:N)
-- zipCd를 행으로 분리해서 인덱스 검색 가능하게 함
-- ========================================
CREATE TABLE policy_region (
    policy_id   BIGINT      NOT NULL,       -- 정책 ID
    zip_code    VARCHAR(20) NOT NULL,       -- 우편번호 (지역 코드)
    PRIMARY KEY (policy_id, zip_code),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- 정책 대상 직종 테이블
-- 정책 1개 : 직종 N개 (1:N)
-- ========================================
CREATE TABLE policy_job (
    policy_id   BIGINT      NOT NULL,       -- 정책 ID
    job_code    VARCHAR(20) NOT NULL,       -- 직종 코드 (API 원본: jobCd)
    PRIMARY KEY (policy_id, job_code),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- 정책 대상 학교 유형 테이블
-- 정책 1개 : 학교 유형 N개 (1:N)
-- ========================================
CREATE TABLE policy_school (
    policy_id   BIGINT      NOT NULL,       -- 정책 ID
    school_code VARCHAR(20) NOT NULL,       -- 학교 유형 코드 (API 원본: schoolCd)
    PRIMARY KEY (policy_id, school_code),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- 정책 대상 전공 테이블
-- 정책 1개 : 전공 N개 (1:N)
-- ========================================
CREATE TABLE policy_major (
    policy_id   BIGINT      NOT NULL,       -- 정책 ID
    major_code  VARCHAR(20) NOT NULL,       -- 전공 코드 (API 원본: plcyMajorCd)
    PRIMARY KEY (policy_id, major_code),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- 정책 대상 업종 테이블
-- 정책 1개 : 업종 N개 (1:N)
-- ========================================
CREATE TABLE policy_business (
    policy_id     BIGINT      NOT NULL,     -- 정책 ID
    business_code VARCHAR(20) NOT NULL,     -- 업종 코드 (API 원본: sBizCd)
    PRIMARY KEY (policy_id, business_code),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- 즐겨찾기(북마크) 테이블
-- 사용자가 저장한 정책 목록 + 마감 알림 ON/OFF
-- ========================================
CREATE TABLE bookmark (
    bookmark_id BIGINT   PRIMARY KEY AUTO_INCREMENT, -- 북마크 고유 ID
    user_id     BIGINT   NOT NULL,                   -- 사용자 ID
    policy_id   BIGINT   NOT NULL,                   -- 정책 ID
    alarm_yn    BOOLEAN  DEFAULT FALSE,              -- 마감 알림 여부
    created_at  DATETIME DEFAULT CURRENT_TIMESTAMP,  -- 북마크 생성일
    FOREIGN KEY (user_id)   REFERENCES user(user_id),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id),
    UNIQUE (user_id, policy_id)                      -- 동일 정책 중복 북마크 방지
);


-- ========================================
-- 고객센터 문의 테이블
-- 1:1 문의 및 관리자 답변 관리
-- 비회원도 문의 가능 (user_id NULL 허용)
-- ========================================
CREATE TABLE inquiry (
    inquiry_id   BIGINT       PRIMARY KEY AUTO_INCREMENT, -- 문의 고유 ID
    user_id      BIGINT,                                  -- 사용자 ID (비회원이면 NULL)
    inquiry_type VARCHAR(50)  NOT NULL,                   -- 문의 유형 (일반/광고제휴/기업제휴/기타)
    title        VARCHAR(255) NOT NULL,                   -- 문의 제목
    content      TEXT         NOT NULL,                   -- 문의 내용
    answer       TEXT,                                    -- 관리자 답변
    status       VARCHAR(20)  DEFAULT 'PENDING',          -- 처리 상태 (PENDING / ANSWERED)
    created_at   DATETIME     DEFAULT CURRENT_TIMESTAMP,  -- 문의 작성일
    answered_at  DATETIME,                                -- 답변 완료일
    FOREIGN KEY (user_id) REFERENCES user(user_id)
);


-- ========================================
-- 공지사항 테이블
-- 관리자가 작성하는 전체 공지
-- ========================================
CREATE TABLE notice (
    notice_id  BIGINT       PRIMARY KEY AUTO_INCREMENT, -- 공지 고유 ID
    admin_id   BIGINT       NOT NULL,                   -- 작성자 ID (관리자)
    title      VARCHAR(255) NOT NULL,                   -- 공지 제목
    content    TEXT         NOT NULL,                   -- 공지 내용
    is_pinned  BOOLEAN      DEFAULT FALSE,              -- 상단 고정 여부
    created_at DATETIME     DEFAULT CURRENT_TIMESTAMP,  -- 작성일
    updated_at DATETIME     DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, -- 수정일
    FOREIGN KEY (admin_id) REFERENCES user(user_id)
);


-- ========================================
-- 시뮬레이션(추천) 결과 테이블
-- 사용자 입력 기반으로 추천된 정책 기록
-- simulation_input에 당시 입력값 저장 (분석용)
-- ========================================
CREATE TABLE simulation_result (
    result_id        BIGINT       PRIMARY KEY AUTO_INCREMENT, -- 결과 고유 ID
    user_id          BIGINT       NOT NULL,                   -- 사용자 ID
    policy_id        BIGINT       NOT NULL,                   -- 추천된 정책 ID
    simulation_input VARCHAR(500) NOT NULL,                   -- 시뮬레이션 당시 입력값 (JSON 문자열)
    created_at       DATETIME     DEFAULT CURRENT_TIMESTAMP,  -- 추천 생성일
    FOREIGN KEY (user_id)   REFERENCES user(user_id),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- OCR 결과 테이블
-- 업로드된 이미지에서 추출한 텍스트 저장
-- 매칭된 정책이 있으면 policy_id 연결
-- ========================================
CREATE TABLE ocr_result (
    ocr_id         BIGINT   PRIMARY KEY AUTO_INCREMENT, -- OCR 결과 고유 ID
    user_id        BIGINT   NOT NULL,                   -- 업로드한 사용자 ID
    extracted_text TEXT     NOT NULL,                   -- OCR로 추출된 텍스트
    policy_id      BIGINT,                              -- 매칭된 정책 ID (없으면 NULL)
    created_at     DATETIME DEFAULT CURRENT_TIMESTAMP,  -- 추출일
    FOREIGN KEY (user_id)   REFERENCES user(user_id),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);


-- ========================================
-- PDF 요약 결과 테이블
-- 업로드된 PDF의 요약문 저장
-- 매칭된 정책이 있으면 policy_id 연결
-- ========================================
CREATE TABLE pdf_summary (
    pdf_id       BIGINT   PRIMARY KEY AUTO_INCREMENT, -- PDF 요약 고유 ID
    user_id      BIGINT   NOT NULL,                   -- 업로드한 사용자 ID
    summary_text TEXT     NOT NULL,                   -- PDF 요약 텍스트
    policy_id    BIGINT,                              -- 매칭된 정책 ID (없으면 NULL)
    created_at   DATETIME DEFAULT CURRENT_TIMESTAMP,  -- 요약 생성일
    FOREIGN KEY (user_id)   REFERENCES user(user_id),
    FOREIGN KEY (policy_id) REFERENCES policy(policy_id)
);